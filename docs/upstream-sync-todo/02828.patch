+<manifest xmlns:android="http://schemas.android.com/apk/res/android">
+    <!-- No permissions: the library never touches the network itself, and
+         WebSettings.setBlockNetworkLoads(true) is legal without INTERNET. -->
+    <application>
+        <!-- Safe Browsing would make the renderer WebView talk to Google on its own. -->
