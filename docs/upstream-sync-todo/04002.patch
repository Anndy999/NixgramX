+            return false;
+        }
+        noSoundHintCell = cell;
+        noSoundHintView.setOnHiddenListener(() -> noSoundHintCell = null);
+        noSoundHintView.showAt(glassHintCellX(cell, cell.getNoSoundIconCenterX()), top, true);
+        return true;
