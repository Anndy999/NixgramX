+        }
+        if (glass.getCaptureSourceCanvas() != null && SharedConfig.chatBlurEnabled()) {
+            mapSnapshot = new MapGlassSnapshot(() -> {
+                glassEngine.invalidate();
+                if (fragmentView != null) {
