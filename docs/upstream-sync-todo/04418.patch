+    private void pokeMapSnapshot() {
+        if (mapSnapshot == null || mapView == null) {
+            return;
+        }
+        if ((mapTexture == null || !mapTexture.isAttachedToWindow()) && !mapSnapshot.hasSurface()) {
+            attachMapSurface();
