+    private static void drawCapturedChild(Canvas canvas, @Nullable View child) {
+        if (child == null || child.getParent() == null || child.getVisibility() != View.VISIBLE || child.getAlpha() <= 0) {
+            return;
+        }
+        canvas.save();
+        canvas.translate(child.getX(), child.getY());
+        child.draw(canvas);
+        canvas.restore();
+    }
