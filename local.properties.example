# Copy to local.properties (gitignored). Do not commit real secrets.
sdk.dir=/path/to/Android/Sdk

# Obtain at https://my.telegram.org/apps  (required — official TG ids will get the app banned)
TELEGRAM_APP_ID=YOUR_TELEGRAM_APP_ID
TELEGRAM_APP_HASH=YOUR_TELEGRAM_APP_HASH

# Release signing (keystore is TMessagesProj/release.keystore; passwords are NOT in git)
KEYSTORE_PASS=YOUR_KEYSTORE_PASS
ALIAS_NAME=nixgramx
ALIAS_PASS=YOUR_ALIAS_PASS

# Optional: build _base package (app.nixgramx.android.base)
# NIXGRAMX_BASE=true
# Or: APP_PACKAGE=app.nixgramx.android.base
